# Template Environment Variables untuk Sevalla Deployment
# Copy file ini ke .env dan isi dengan nilai yang sesuai

# =============================================================================
# TELEGRAM BOT CONFIGURATION (WAJIB)
# =============================================================================

# Token bot dari @BotFather (Format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz)
TG_BOT_TOKEN=

# API ID dari my.telegram.org (Format: angka saja)
APP_ID=

# API Hash dari my.telegram.org (Format: string 32 karakter)
API_HASH=

# ID Channel untuk database (Format: angka negatif untuk channel)
CHANNEL_ID=

# ID Owner bot (Format: angka positif)
OWNER=

# =============================================================================
# DATABASE CONFIGURATION (OPSIONAL)
# =============================================================================

# URL Database PostgreSQL atau SQLite
# PostgreSQL: postgresql://username:password@host:port/database
# SQLite: sqlite:///path/to/database.db
DATABASE_URL=

# =============================================================================
# TELEGRAM BOT SETTINGS (OPSIONAL)
# =============================================================================

# Jumlah worker untuk bot (default: 4)
TG_BOT_WORKERS=4

# Protect content (true/false)
PROTECT_CONTENT=false

# Custom start message
START_MESSAGE=<b>Hello {first}</b>\n\n<b>Saya dapat menyimpan file pribadi di Channel Tertentu dan pengguna lain dapat mengaksesnya dari link khusus.</b>

# Force subscription message
FORCE_SUB_MESSAGE=<b>Hello {first}\n\nAnda harus bergabung di Channel/Grup saya Terlebih dahulu untuk Melihat File yang saya Bagikan\n\nSilakan Join Ke Channel & Group Terlebih Dahulu</b>

# Custom caption untuk file
CUSTOM_CAPTION=

# Disable channel button (true/false)
DISABLE_CHANNEL_BUTTON=false

# =============================================================================
# FORCE SUBSCRIPTION (OPSIONAL - MULTIPLE SUPPORT)
# =============================================================================

# ID Channel untuk force subscription (Format: angka negatif)
# Support multiple channels: FORCE_SUB_CHANNEL1, FORCE_SUB_CHANNEL2, dll.
FORCE_SUB_CHANNEL1=0
FORCE_SUB_CHANNEL2=0
FORCE_SUB_CHANNEL3=0

# ID Group untuk force subscription (Format: angka negatif)
# Support multiple groups: FORCE_SUB_GROUP1, FORCE_SUB_GROUP2, dll.
FORCE_SUB_GROUP1=0
FORCE_SUB_GROUP2=0
FORCE_SUB_GROUP3=0

# =============================================================================
# ADMIN USERS (OPSIONAL)
# =============================================================================

# ID Admin dipisahkan spasi (Format: angka positif)
ADMINS=

# =============================================================================
# HEROKU CONFIGURATION (OPSIONAL - untuk updater)
# =============================================================================

# Nama aplikasi Heroku
HEROKU_APP_NAME=

# API Key Heroku
HEROKU_API_KEY=

# Branch untuk updater
UPSTREAM_BRANCH=master

# Repository untuk updater
UPSTREAM_REPO=https://github.com/mrismanaziz/File-Sharing-Man.git

# =============================================================================
# SEVAAVA DEPLOYMENT NOTES
# =============================================================================
#
# 1. Set environment variables di Sevalla dashboard
# 2. Pastikan TG_BOT_TOKEN, APP_ID, API_HASH, CHANNEL_ID, dan OWNER sudah diset
# 3. Gunakan "bash start" sebagai startup command di Sevalla
# 4. Bot akan otomatis restart jika crash
# 5. Logs tersimpan di /app/logs/
# 6. Untuk multiple force subscriptions, tambahkan FORCE_SUB_CHANNEL2, FORCE_SUB_GROUP2, dll.
# 7. Bot otomatis mendeteksi env baru tanpa restart manual
#
# =============================================================================